SECRET_KEY=replace-with-a-long-random-value
EXTERNAL_URL=https://example.ru
PORT=5000
BIND_ADDRESS=127.0.0.1
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
SEED_DEMO_DATA=false
TRUST_PROXY_HEADERS=false

CRM_OIDC_ENABLED=true
CRM_OIDC_ISSUER=https://lk.silaeder.ru
CRM_OIDC_CLIENT_ID=coding-projects
CRM_OIDC_CLIENT_SECRET=secret-from-crm

# Needed only when an OIDC email matches an existing local account.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=true
